{
  "name": "weft",
  "private": true,
  "description": "Weft: an identity wallet for Hyperledger Fabric networks",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:extension": "pnpm --filter @weft/extension dev",
    "dev:docs": "pnpm --filter @weft/docs dev",
    "dev:relay": "pnpm --filter @weft/relay dev"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
