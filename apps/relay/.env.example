# Peer Gateway endpoint the relay forwards to.
WEFT_PEER_ENDPOINT=localhost:7051
# TLS: CA certificate for the peer's TLS cert, and the hostname it was issued for.
WEFT_PEER_TLS_CA_CERT=../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
WEFT_PEER_HOST_ALIAS=peer0.org1.example.com
# Comma-separated browser origins allowed to call the relay. Use your extension's origin in production.
WEFT_ALLOWED_ORIGINS=*
# Optional: only serve signers from these MSPs.
WEFT_ALLOWED_MSP_IDS=Org1MSP
PORT=8787
